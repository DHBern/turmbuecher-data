5,8493,5728,8493,6268,8541,7529,8577,8795,8638,8904,8662,8904,8863,8795,8839,8432,8815,6268,8742,5728,8694,5365,8694],[5304,8734,8916,8916,8916,9117,5304,8936],[5328,8984,5510,9008,6771,9045,8037,9154,8928,9154,8928,9355,8037,9355,6771,9246,5510,9210,5328,9186],[5328,9250,6594,9311,7856,9420,8879,9432,8879,9633,7856,9621,6594,9512,5328,9452],[5232,9528,6316,9553,8122,9710,8976,9722,8976,9923,8122,9911,6316,9754,5232,9730],[5292,9794,6558,9863,8182,10008,8892,10008,8892,10210,8182,10210,6558,10064,5292,9996],[5220,10056,6844,10165,7565,10250,8468,10310,8976,10310,8976,10512,8468,10512,7565,10451,6844,10367,5220,10258],[5195,10359,5558,10347,6280,10395,7541,10540,8807,10637,8831,10625,8831,10826,8807,10838,7541,10742,6280,10597,5558,10548,5195,10560],[5304,10588,6026,10657,6747,10754,8722,10899,8722,11100,6747,10955,6026,10859,5304,10790],[5208,10826,5929,10887,6292,10959,7013,11044,8638,11165,8734,11189,8734,11391,8638,11366,7013,11245,6292,11161,5929,11088,5208,11028],[5220,11068,5401,11056,6844,11298,7565,11358,7928,11419,8626,11487,8626,11689,7928,11620,7565,11560,6844,11499,5401,11258,5220,11270]],"text":["Hanß Růdolff von","Grÿers Burger alhie.","Ist wegen der den 18ten. Junÿ 1652","nach 9. vhren nach Mittag an","der Crützgaßen an Jr. Hanß Jacob","von Bonstetten, vnd Hrn. Anthoni von","Graffenriedt den jüngeren verückten","gantz vnredlichen fast Mörderisch er¬","achtenden thadt vnd attentat nach","wÿtlöüffig vnd vnderschidenlich ver¬","hördten Kundtscht. (So in der Cantzleÿ","zefinden, vnd vor Raht durch Hrn.","Rahtshrn. Huser Schrifftlich ÿngelegt","worden) nach gedeüter beider ver¬","wundten Herren Convalescentz der","lang vsgestandnen Gfangenscht. ledig","erkendt, vnd verfelt worden nachge¬","schribenen Eidt vnd vrphed zeschweren","vnd nach zesprechen.","Eidt","Ich Hanß Růdolf von Grÿers","Schweren bÿ dem gegenwürtigen","alwüßnden, warhafften, gerechten,","vnd allmechtigen Gott, daß ich von","der nechtlicher wÿl mit einem vngewondt","vnzůläßigen meßer an Jr. Hanß Jacob","von Bonstetten, vnd Hrn. Anthoni von","Graffenried begangnen, theils thodts","gefärlich gewesnen wundtatten, vnd","sonst anderer zum zÿthen getragner","verbotnen wehren wegen, zu mehr dan","woluerdienter Straf von ledig laßung","an diser meiner jetzigen gefangenscht.","M. gn. Hrn. vnnd Oberen diser Loblichen","Statt Bern Stett vnd Landt, vnd gebiet","quittieren, verlaßen, abtredten, vnd selbs","nit widerumb betredten, durch wandern","noch durch ziechen: Auch dise eine zensur","von diser leidigen verbrachten action, vnd","mißhandlung har, vsgestandne gfangenscht.","an niemanden rechen will. Alle","geuert vermitten etc. Geschworen","den 6ten Augusti 1652.","40.","Anna Gÿsiger, Anna Bichsel","vnnd Barbli Wäber.","Den 8. Julÿ 1652 Sind durch mÿnen","hochehrenden Herren, Hrn. Geörg Thorman","deß kleinen, vnnd Jrn. Großweÿbel von","Wattenwÿl, vnd Hrn. Houbtman Gabriel","Wÿß deß großen Rahts, die deß vorver¬","gangnen tags gfenklich von Frouwbrun̄en","alhar gefhüerte der Hexereÿ verdechtige","alte Anni Gÿsiger, Anni Bichsel,","vnd Barbli Wäber von Limpach,","in der Gefangenscht. ernstwörtig exami¬","niert worden, Die habendt aber","diser anklagen halber gantz vnschuldig","sÿn wöllen; Zwar bekendt, daß nun","ein gůte zeith dahär vihl Roß, vndt","vÿch druf gangen, deßen Sie Bichsel","vnd Wäberin auch Selbs nit ein wenig","empfunden, Sÿ wüßindt aber demselbigen nützit","zethůn; Jedoch hatt Anni Gÿsiger, So sonst","zů Biberach in den hochen Grichten daheimen,","bekendt: Nach dem Sÿ vor vngefahr","3 oder 4 wochen im holtz ihren Geisli","gehüetet, vnd dabÿ entschlaffen, habe Sÿ","in dem Schlaff mit dem bösen Geist","(Gott behüete vnß) gemeinschft. gehabt","vnd nachdem Sie drüber erwachete, vfge¬","standen, Seÿe Sÿ ein großes Zitern vnd","Schrecken, darus Sÿ diser action abgenom̄en","angangen, vnd ihra von einem in gestalt","eines jungen Gsellen, gelt anerboten worden,","welches sÿe grobe sorten sÿn bedunckt,","Sie habe aber selbiges nit empfachen","Wöllen Sonder abgeschlagen vnnd gesagt","wan Sie schon nit vihl habe, So habe Sie","doch gnůg, daruf sich gesegnet, vnd Gott","angerüefft, v̈ber welches diser junge","Gsell verschwunden, sonsten seÿe ihra derglÿchen","den tag ihres läbens niemahlen mehr","wider fahren, Besorge vnd erachte aber","ihre Sohns frouw, die bÿ ihra im hus Seÿe,","habe Solch v̈bel v̈ber Sie mit ihrem flůchen"],"region":["paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph","paragraph"]}
